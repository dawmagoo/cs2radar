{
  "name": "cs2-webradar",
  "version": "1.8.0",
  "private": true,
  "description": "Radar CS2 z podglądem minimapy i opcjonalną telemetrią GSI",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:portable": "electron-builder --win portable --x64",
    "maps:import": "node scripts/import-maps.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "4.22.3",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "pl.cs2webradar.desktop",
    "productName": "CS2 WebRadar",
    "artifactName": "CS2-WebRadar-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "electron-main.js",
      "preload.js",
      "server.js",
      "telemetry.js",
      "public/**/*",
      "package.json",
      "map-store.js",
      "lan-sharing.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "CS2-WebRadar-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "pl_PL",
        "en_US"
      ]
    },
    "portable": {
      "artifactName": "CS2-WebRadar-Portable-${version}-${arch}.${ext}"
    },
    "toolsets": {
      "wine": "1.0.1",
      "nsis": "1.2.1"
    }
  }
}
